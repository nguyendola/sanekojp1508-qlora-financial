ialized.\")\n","    except ValueError as e:\n","        if \"VM is already running\" in str(e):\n","            print(\"VnCoreNLP segmenter was likely initialized in a previous run or JVM already started. Continuing with existing segmenter if available.\")\n","            # If this specific ValueError occurs and segmenter is not yet in locals(),\n","            # it implies the JVM was started externally and segmenter needs to be defined.\n","            # For robustness, if the VM is running but segmenter is not defined, a kernel restart is typically required.\n","            # This workaround is primarily for preventing errors when re-running the cell where segmenter *was* defined previously.\n","        else:\n","            raise e\n","else:\n","    print(\"VnCoreNLP segmenter already exists.\")\n","\n","def preprocess_text(text):\n","    text = str(text).strip()\n","    return \" \".join(segmenter.word_segment(text))"],"metadata":{"id":"35exTL958jSz","executionInfo":{"status":"ok","timestamp":1775978427018,"user_tz":-420,"elapsed":16,"user":{"displayName":"Andrew Ng Phan","userId":"02164905559982412815"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"8f2a4fc9-243c-4cde-920c-e125e81e15c6"},"execution_count":39,"outputs":[{"output_type":"stream","name":"stdout","text":["VnCoreNLP segmenter already exists.\n"]}]},{"cell_type":"code","source":["# Tokenize + gắn labels\n","def tokenize_and_align_labels(examples):\n","    texts = [preprocess_text(text) for text in examples[\"Content\"]]\n","\n","    tokenized_inputs = tokenizer(\n","        texts,\n","        padding=\"max_length\",\n","        truncation=True,\n","        max_length=256\n","    )\n","\n","    tokenized_inputs[\"labels\"] = [label2id[label] for label in examples[\"Sentiment\"]]\n","    return tokenized_inputs"],"metadata":{"id":"LgSwtGTEhunm","executionInfo":{"status":"ok","timestamp":1775978432280,"user_tz":-420,"elapsed":2,"user":{"displayName":"Andrew Ng Phan","userId":"02164905559982